<%= turbo_page_requires_reload %>
<%= content_for :title, "Tổng kết giao dịch" %>

<%= content_for :page_header_actions do %>
  <%= render Views::Reports::TransactionSummary::FilterForm.new(form: @form) %>
<% end %>

<%= render Views::Reports::TransactionSummary::SummaryTable.new(summary: @summary) %>
<%= render RubyUI::Separator.new %>
<%= render Views::Reports::TransactionSummary::DetailTable.new(transactions: @transactions, pagy: @pagy, total_amount_in: @total_amount_in, total_amount_out: @total_amount_out) %>
<% if @pagy.pages > 1 %>
  <div class="flex justify-center py-4 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<%# Để tránh giao diện bị co lại khi bảng có ít dòng dữ liệu, các component ảnh hưởng: datetimepicker,... %>
<div class="h-screen"></div>